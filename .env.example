# Slack app credentials (Socket Mode)
# Bot token from OAuth & Permissions (xoxb-...)
SLACK_BOT_TOKEN=
# App-level token with connections:write scope (xapp-...)
SLACK_APP_TOKEN=

# Jump Desktop API
# Bearer token generated at https://app.jumpdesktop.com -> Security -> Generate New Token
JUMPDESKTOP_API_TOKEN=

# Jump Desktop team IDs (from https://jumpdesktop.com/dashboard/teams/<teamID>/users)
JUMPDESKTOP_NY_TEAM_ID=T-01GW30D3R7T1717HTHWYQ7DW45
JUMPDESKTOP_LA_TEAM_ID=T-01H6VNE44DZDD0C2TVZC1Z4V57

# Optional: channel ID to post an audit trail of granted access (e.g. #gfx-access-log)
AUDIT_CHANNEL_ID=
